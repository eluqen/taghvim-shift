<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <FrameLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_board_bg">

        <ImageView
            android:id="@+id/widget_custom_background"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:visibility="gone"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/widget_content_body"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="vertical"
            android:padding="0dp"
            android:background="@android:color/transparent"
            android:layoutDirection="rtl">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="25dp">

            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="22dp"
                android:layout_height="25dp"
                android:layout_gravity="left|center_vertical"
                android:gravity="center"
                android:text="↻"
                android:textSize="15sp"
                android:textColor="#DDF7F5"
                android:background="@drawable/widget_control_chip"
                android:contentDescription="به‌روزرسانی ویجت" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginLeft="26dp"
                android:layout_marginRight="26dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layoutDirection="rtl">

                <TextView
                    android:id="@+id/widget_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:textSize="10.5sp"
                    android:textColor="#CBE7E7"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_plan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:textSize="10sp"
                    android:textColor="#9FC9CC"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_settings"
                android:layout_width="22dp"
                android:layout_height="25dp"
                android:layout_gravity="right|center_vertical"
                android:gravity="center"
                android:text="⚙"
                android:textSize="13sp"
                android:textColor="#DDF7F5"
                android:background="@drawable/widget_control_chip"
                android:contentDescription="تنظیمات ویجت" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_group_board"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:layout_marginTop="0dp"
            android:orientation="vertical"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="@drawable/widget_board_panel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:orientation="horizontal"
                android:layoutDirection="rtl">

                <TextView android:id="@+id/widget_group_header_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#BFE5E5" android:background="@drawable/widget_group_cell" android:maxLines="1" />
                <TextView android:id="@+id/widget_group_header_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="2dp" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#BFE5E5" android:background="@drawable/widget_group_cell" android:maxLines="1" />
                <TextView android:id="@+id/widget_group_header_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="2dp" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#BFE5E5" android:background="@drawable/widget_group_cell" android:maxLines="1" />
                <TextView android:id="@+id/widget_group_header_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="2dp" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#BFE5E5" android:background="@drawable/widget_group_cell" android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="1dp"
                android:orientation="horizontal"
                android:layoutDirection="rtl">

                <TextView android:id="@+id/widget_group_value_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/widget_group_cell" android:maxLines="1" />
                <TextView android:id="@+id/widget_group_value_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="2dp" android:gravity="center" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/widget_group_cell" android:maxLines="1" />
                <TextView android:id="@+id/widget_group_value_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="2dp" android:gravity="center" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/widget_group_cell" android:maxLines="1" />
                <TextView android:id="@+id/widget_group_value_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginRight="2dp" android:gravity="center" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/widget_group_cell" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/widget_shift" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/widget_hours" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/widget_next" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/widget_groups" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/widget_reminder" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
